{
  "name": "@licham/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types --experimental-loader ../core/scripts/ts-extension-loader.mjs scripts/generate-tu-vi.ts && node --experimental-strip-types --experimental-loader ./scripts/ts-web-loader.mjs scripts/generate-sitemap.ts && next build",
    "postbuild": "node scripts/check-routes.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "generate:tu-vi": "node --experimental-strip-types --experimental-loader ../core/scripts/ts-extension-loader.mjs scripts/generate-tu-vi.ts",
    "generate:sitemap": "node --experimental-strip-types --experimental-loader ./scripts/ts-web-loader.mjs scripts/generate-sitemap.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "seo:audit": "node scripts/seo-audit.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@licham/core": "workspace:*",
    "next": "15.5.25",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.17.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
